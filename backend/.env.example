# Copy this file to `.env` and adjust as needed.
# All values shown are safe, working defaults for local development.

ENV=development

# --- Database ---
# Default: local SQLite file at backend/data/app.db
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/screening
DATABASE_URL=

# --- Vector store / knowledge base ---
VECTOR_STORE_DIR=
KNOWLEDGE_BASE_DIR=

# --- Embeddings ---
# "hashing" (default, zero dependencies/network) or "sentence-transformers"
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- LLM provider for extraction / question generation / summaries ---
# "fallback" (default, no API key needed, rule-based) | "anthropic" | "openai"
LLM_PROVIDER=fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Chunking ---
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- Interview flow ---
QUESTIONS_PER_SESSION=6
RETRIEVAL_TOP_K=4

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:3000
